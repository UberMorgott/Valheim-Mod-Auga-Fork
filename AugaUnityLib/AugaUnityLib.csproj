<Project Sdk="Microsoft.NET.Sdk">

  <!-- LangVersion, determinism, PathMap, embedded PDB, SourceLink off, ValheimDir/ManagedDir, polyfills and the
       publicizer come from build\Valheim.Build.props. Unity.Auga uses no BepInEx/Harmony API. -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <ValheimPlugin>true</ValheimPlugin>
    <ValheimBepInExRefs>false</ValheimBepInExRefs>
    <ValheimUsePublicizer>true</ValheimUsePublicizer>
    <AssemblyName>Unity.Auga</AssemblyName>
    <RootNamespace>AugaUnity</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Отключаем авто-включение файлов из поддиректорий с иным форматом -->
    <Nullable>disable</Nullable>
    <!-- SDK-style auto-generates AssemblyInfo — отключаем чтобы не конфликтовало с Properties/AssemblyInfo.cs -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <DefineConstants>TRACE;DEBUG;UNITY_5_6_OR_NEWER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>


  <ItemGroup>
    <!-- Valheim assemblies — публикуются автоматически через BepInEx.AssemblyPublicizer.MSBuild -->
    <Reference Include="assembly_guiutils">
      <HintPath>$(ManagedDir)\assembly_guiutils.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_postprocessing">
      <HintPath>$(ManagedDir)\assembly_postprocessing.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_sunshafts">
      <HintPath>$(ManagedDir)\assembly_sunshafts.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)\assembly_utils.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ManagedDir)\assembly_valheim.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <!-- ui_lib переименован в gui_framework в новых версиях Valheim -->
    <Reference Include="gui_framework">
      <HintPath>$(ManagedDir)\gui_framework.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>

    <!-- UnityEngine — берём из valheim_Data\Managed (полные, нестриппнутые) -->
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
<Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Исключаем устаревший Coffee.UIEffects пакет — несовместим с Unity 6 UGUI 2.0 -->
  <ItemGroup>
    <Compile Remove="UIEffect.cs" />
    <Compile Remove="UIDissolve.cs" />
    <Compile Remove="UIHsvModifier.cs" />
    <Compile Remove="UIFlip.cs" />
    <Compile Remove="UIGradient.cs" />
  </ItemGroup>

  <!-- После сборки — копируем Unity.Auga.dll в Unity проект -->
  <Target Name="CopyToUnity" AfterTargets="Build">
    <Exec Command="xcopy &quot;$(TargetDir)$(TargetFileName)&quot; &quot;$(SolutionDir)AugaUnity\Assets\ExternalLibraries\&quot; /q /y /i"
          Condition="Exists('$(SolutionDir)AugaUnity\Assets\ExternalLibraries\')" />
  </Target>

</Project>
