<Project Sdk="Microsoft.NET.Sdk">

  <!-- Пути к Valheim и BepInEx -->
  <Import Project="..\Valheim.props" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <!-- New assembly name (spec D0a): consumers detect assembly "Auga". RootNamespace stays Auga, so the embedded
         resources keep their Auga.* names. -->
    <AssemblyName>AugaSkin</AssemblyName>
    <RootNamespace>Auga</RootNamespace>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>10</LangVersion>
    <Deterministic>true</Deterministic>
    <Nullable>disable</Nullable>
    <!-- Отключаем авто-генерацию AssemblyInfo — Properties\AssemblyInfo.cs уже есть -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ProjectGuid>{BCC7DD31-D943-4684-800E-176A97DDDB8F}</ProjectGuid>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- NuGet пакеты -->
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" />
    <!-- ILRepack.Lib.MSBuild.Task несовместим с .NET 10 SDK и избыточен:
         APIManager is vendored as source (APIManagerPatcher.cs), nothing to merge -->
  </ItemGroup>

  <!-- Ссылки на BepInEx -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Valheim assemblies — публикуются через BepInEx.AssemblyPublicizer.MSBuild -->
    <Reference Include="assembly_guiutils">
      <HintPath>$(ValheimManagedDir)\assembly_guiutils.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(ValheimManagedDir)\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimManagedDir)\assembly_utils.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManagedDir)\assembly_valheim.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="Splatform">
      <HintPath>$(ValheimManagedDir)\Splatform.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SoftReferenceableAssets">
      <HintPath>$(ValheimManagedDir)\SoftReferenceableAssets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="gui_framework">
      <HintPath>$(ValheimManagedDir)\gui_framework.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>

    <!-- UnityEngine -->
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ValheimManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- fastJSON -->
    <Reference Include="fastJSON">
      <HintPath>..\Libs\fastJSON.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Встроенные ресурсы -->
  <ItemGroup>
    <EmbeddedResource Include="..\AugaUnity\AssetBundles\augaassets">
      <Link>augaassets</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\AugaUnityLib\bin\$(Configuration)\net472\Unity.Auga.dll">
      <Link>Unity.Auga.dll</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Libs\fastJSON.dll">
      <Link>fastJSON.dll</Link>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AugaUnityLib\AugaUnityLib.csproj" />
  </ItemGroup>

</Project>
